flowchart TD

subgraph group_api["API boundary"]
  node_application{{"Spring application<br/>application entry point"}}
  node_controller["Workflow controller<br/>HTTP controller"]
  node_runtime_config["Runtime configuration<br/>Spring properties"]
end

subgraph group_runtime["Workflow runtime"]
  node_orchestrator["Workflow orchestrator<br/>application service"]
  node_event_service["Workflow event service"]
  node_decision_engine["Decision engine<br/>rules service"]
  node_decision["Workflow decision<br/>decision result"]
end

subgraph group_domain["Workflow domain"]
  node_event["Workflow event<br/>event model<br/>[WorkFlowEvent.java]"]
  node_state["Workflow state<br/>runtime state<br/>[WorkFlowState.java]"]
  node_definition["Workflow definition<br/>definition model"]
  node_step["Workflow step<br/>definition step<br/>[WorkflowStep.java]"]
  node_activity_status["Activity status<br/>status enum"]
  node_step_status["Step status<br/>status enum<br/>[StepStatus.java]"]
end

subgraph group_definitions["Definition setup"]
  node_configuration["Workflow configuration<br/>definition registry"]
end

subgraph group_persistence["Event persistence"]
  node_event_repository[("Event repository")]
  node_backing_store[("Backing store<br/>data store")]
  node_local_infrastructure["Local infrastructure<br/>container compose<br/>[compose.yaml]"]
end

node_application -->|"starts"| node_controller
node_runtime_config -.->|"configures"| node_application
node_controller -->|"delegates workflow actions"| node_orchestrator
node_controller -->|"delegates event operations"| node_event_service
node_orchestrator -->|"evaluates transition"| node_decision_engine
node_orchestrator -->|"records and retrieves events"| node_event_service
node_event_service -->|"persists events"| node_event_repository
node_event_repository -->|"reads and writes"| node_backing_store
node_local_infrastructure -.->|"provisions locally"| node_backing_store
node_event_service -->|"handles"| node_event
node_orchestrator -->|"updates lifecycle"| node_state
node_decision_engine -->|"evaluates"| node_state
node_decision_engine -->|"consumes"| node_event
node_decision_engine -->|"produces"| node_decision
node_orchestrator -->|"applies"| node_decision
node_orchestrator -->|"resolves definitions"| node_configuration
node_configuration -->|"registers"| node_definition
node_definition -->|"contains"| node_step
node_state -.->|"tracks"| node_activity_status
node_state -.->|"tracks"| node_step_status

